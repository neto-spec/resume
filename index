<script>
  // Carousel state
  const carouselState = {
    soft: 0,
    hard: 0
  };
  
  const cardWidth = 380;
  
  function scrollCarousel(type, direction) {
    const track = document.getElementById(type + '-track');
    const cards = track.children.length;
    const maxScroll = Math.max(0, cards - Math.floor(track.parentElement.offsetWidth / cardWidth));
    
    carouselState[type] += direction;
    if (carouselState[type] < 0) carouselState[type] = 0;
    if (carouselState[type] > maxScroll) carouselState[type] = maxScroll;
    
    track.style.transform = `translateX(-${carouselState[type] * cardWidth}px)`;
  }
  
  function scrollToSection(id) {
    document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');
  }
  
  // Create floating particles
  const particlesContainer = document.getElementById('particles');
  for (let i = 0; i < 30; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDelay = Math.random() * 15 + 's';
    p.style.animationDuration = (10 + Math.random() * 10) + 's';
    p.style.width = (2 + Math.random() * 4) + 'px';
    p.style.height = p.style.width;
    particlesContainer.appendChild(p);
  }
  
  // Animate grade bars on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const fills = entry.target.querySelectorAll('.grade-bar-fill');
        fills.forEach((fill, i) => {
          const width = fill.style.width;
          fill.style.width = '0%';
          setTimeout(() => fill.style.width = width, i * 100);
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  
  document.querySelectorAll('.skill-card').forEach(card => observer.observe(card));
  
  // Touch/drag support for carousels
  let isDragging = false;
  let startX = 0;
  
  document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
    wrapper.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX;
    });
    wrapper.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const x = e.pageX;
      const diff = startX - x;
      if (Math.abs(diff) > 50) {
        const track = wrapper.querySelector('.carousel-track');
        const type = track.id.replace('-track', '');
        scrollCarousel(type, diff > 0 ? 1 : -1);
        isDragging = false;
      }
    });
    wrapper.addEventListener('mouseup', () => isDragging = false);
    wrapper.addEventListener('mouseleave', () => isDragging = false);
  });
</script>
